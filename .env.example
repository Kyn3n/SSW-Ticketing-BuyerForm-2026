# Copy this file to `.env` and set it to the backend API's base URL.
# Exposed to the browser at build time (NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_API_BASE_URL="https://api.example.com"

# Public URL this app is served at, used to resolve absolute URLs for
# Open Graph / Twitter share images. Set to the production domain when deployed.
NEXT_PUBLIC_SITE_URL="https://tickets.example.com"
