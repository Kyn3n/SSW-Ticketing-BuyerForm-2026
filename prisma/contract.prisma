// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model AuditLogs {
  id        Uuid        @id(map: "audit_logs_pkey")
  action    String
  actorId   Uuid        @map("actor_id")
  createdAt Timestamptz @default(now()) @map("created_at")
  metadata  Json?
  targetId  Uuid        @map("target_id")

  @@map("audit_logs")
}

model Orders {
  id                   Uuid         @id(map: "orders_pkey")
  createdAt            Timestamptz  @default(now()) @map("created_at")
  email                String
  name                 String
  phone                String
  reviewedAt           Timestamptz? @map("reviewed_at")
  reviewedBy           Uuid?        @map("reviewed_by")
  screenshotObjectPath String       @map("screenshot_object_path")
  seatCount            Int          @map("seat_count")
  status               String       @default("PENDING")
  tickets              Tickets[]

  @@check(expression: "(status = ANY (ARRAY['PENDING'::text, 'APPROVED'::text, 'REJECTED'::text]))", map: "orders_status_check_56005a61")
  @@map("orders")
}

model Tickets {
  id        Uuid         @id(map: "tickets_pkey")
  orderId   Uuid         @map("order_id")
  qrToken   String       @unique(map: "tickets_qr_token_key") @map("qr_token")
  scannedAt Timestamptz? @map("scanned_at")
  scannedBy Uuid?        @map("scanned_by")
  seatIndex Int          @map("seat_index")
  status    String       @default("valid")
  order     Orders       @relation(fields: [orderId], references: [id], map: "tickets_order_id_fkey")

  @@index([orderId], name: "tickets_order_id_idx")
  @@map("tickets")
}

model Users {
  id        Uuid        @id(map: "users_pkey")
  createdAt Timestamptz @default(now()) @map("created_at")
  email     String      @unique(map: "users_email_key")
  invitedBy Uuid?       @map("invited_by")
  role      String

  @@map("users")
}
